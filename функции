Напишите функцию modify_list(l), которая принимает на вход список целых чисел, удаляет из него все нечётные значения, а чётные нацело делит на два.
def modify_list(l):
    # put your python code here
    c=0
    for i in range(0, len(l)):
        if l[i-c]%2==0:
            l[i-c]=l[i-c]//2
        else:
            del l[i-c]
            c+=1
